// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`default renderer: title > should hide the task when its title and output are removed > exit 1`] = `[]`;

exports[`default renderer: title > should hide the task when its title and output are removed > screen 1`] = `
[
  "◼ This task will execute.",
  "◼ This task will execute.
◼ This task keeps its title.",
  "❯ This task will execute.
◼ This task keeps its title.",
  "❯ This task will execute.
  › I will push an output.
◼ This task keeps its title.",
  "  › I will push an output.
◼ This task keeps its title.",
  "◼ This task keeps its title.",
  "❯ This task keeps its title.",
  "✔ This task keeps its title.",
]
`;

exports[`default renderer: title > should hide the task when its title and output are removed > stderr 1`] = `[]`;

exports[`default renderer: title > should render the title again after it has been removed > exit 1`] = `[]`;

exports[`default renderer: title > should render the title again after it has been removed > screen 1`] = `
[
  "◼ This task will execute.",
  "❯ This task will execute.",
  "",
  "❯ This title is restored.",
  "✔ This title is restored.",
]
`;

exports[`default renderer: title > should render the title again after it has been removed > stderr 1`] = `[]`;
