amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// Every workspace carries its own `eslint.config.mjs` layered on top of the
// root one, each bound to that workspace's `tsconfig.json`. Linting per
// workspace keeps that layering, which a single root invocation would lose, so
// every workspace owns an `hk.pkl` next to its code holding the eslint step
// that used to be its `lint-staged` block. hk merges those into this config
// scoped to their directory: globs and working directories are re-rooted
// there, and the steps show up as `packages/listr2:eslint`.
subprojects = List("docs", "examples", "packages/*")

hooks {
  ["pre-commit"] {
    fix = true
    // lint-staged parity: hide the unstaged hunks of a partially staged file
    // while the fix steps run, then restore them afterwards.
    stash = "git"
    steps {
      // Prettier has one root config and no per-workspace layering, so it stays
      // here and covers the whole repository in a single pass.
      ["prettier"] = (Builtins.prettier) {
        glob = List("*.ts", "*.js", "*.tsx", "*.jsx", "*.json", "*.md")
      }
    }
  }
  ["prepare-commit-msg"] {
    steps {
      ["commitizen"] {
        fix = "git cz --hook"
        interactive = true
      }
    }
  }
  ["pre-push"] {
    steps {
      ["test"] {
        check = "pnpm run test"
      }
    }
  }
}
