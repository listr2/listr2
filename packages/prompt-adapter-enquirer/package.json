{
  "name": "@listr2/prompt-adapter-enquirer",
  "version": "5.0.0-beta.10",
  "description": "Listr2 prompt adapter for enquirer.",
  "license": "MIT",
  "repository": "https://github.com/listr2/listr2",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "author": {
    "name": "Cenk Kilic",
    "email": "cenk@kilic.dev",
    "url": "https://cenk.kilic.dev"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "scripts": {
    "build": "tsdown",
    "dev:start": "tsdown --watch",
    "format": "prettier --log-level warn --write src/ tests/ && pnpm run lint --fix",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:cov": "pnpm run test --coverage",
    "test:dev": "vitest --config tests/vitest.config.ts --inspect=0.0.0.0:9229 --no-file-parallelism --reporter verbose"
  },
  "keywords": [
    "listr",
    "listr2",
    "cli",
    "task",
    "list",
    "tasklist",
    "terminal",
    "term",
    "console",
    "ascii",
    "unicode",
    "loading",
    "indicator",
    "progress",
    "busy",
    "wait",
    "idle"
  ],
  "devDependencies": {
    "listr2": "^12.0.0-beta.1",
    "enquirer": "^2.4.1"
  },
  "peerDependencies": {
    "enquirer": ">= 2.3.0 < 3",
    "listr2": "^12.0.0-beta.1"
  }
}
